import java.util.Scanner;

public class Special {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n, sum = 0;

        while (temp > 0) {
            int d = temp % 10;
            sum += fact(d);
            temp /= 10;
        }

        if (sum == n)
            System.out.println("YES");
        else
            System.out.println("NO");
    }

    static int fact(int x) {
        int f = 1;
        for (int i = 1; i <= x; i++) f *= i;
        return f;
    }
}
