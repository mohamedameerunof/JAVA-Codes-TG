import java.util.Scanner;

public class SPattern {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Enter size of the S pattern (minimum 3): ");
        int size = scanner.nextInt();

        if (size < 3) {
            System.out.println("Size must be at least 3.");
            return;
        }

        int mid = size / 2;

        for (int i = 0; i < size; i++) {
            for (int j = 0; j < size; j++) {
                if (i == 0 || i == mid || i == size - 1) {
                    System.out.print("* ");
                } else if (i < mid && j == 0) {
                    System.out.print("* ");
                } else if (i > mid && j == size - 1) {
                    System.out.print("* ");
                } else {
                    System.out.print("  ");
                }
            }
            System.out.println();
        }

        scanner.close();
    }
}
