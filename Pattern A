import java.util.Scanner;

public class PatternA {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Enter the height of the letter A: ");
        int n = scanner.nextInt();

        for (int i = 0; i < n; i++) {
            for (int j = 0; j <= n; j++) {
                if ((j == 0 || j == n) && i != 0 || 
                    (i == 0 && j > 0 && j < n) || 
                    i == n / 2 && j > 0 && j < n) {
                    System.out.print("*");
                } else {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }

        scanner.close();
    }
}
