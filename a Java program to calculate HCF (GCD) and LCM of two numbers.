import java.util.Scanner;
public class HcfLcm {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();

        int hcf = findHCF(a, b);
        int lcm = (a == 0 || b == 0) ? 0 : (a * b) / hcf;

        System.out.println(hcf);
        System.out.println(lcm);
    }

    static int findHCF(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
